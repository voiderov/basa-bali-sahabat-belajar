# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
# Copy to .env and fill in. NEVER commit real secrets.

# Kunci Google Gemini milik tim (dipakai pertama untuk Guru Basa & koreksi latihan)
GEMINI_API_KEY=

# Opsional: ganti model Gemini (default: gemini-3.8-flash)
GEMINI_MODEL=

# Cadangan otomatis bila Gemini sedang penuh / kuota habis (Lovable AI Gateway).
# Di Lovable nilai ini disediakan otomatis.
LOVABLE_API_KEY=
